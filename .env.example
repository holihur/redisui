# Copy to .env and source it before running ./redisui, or set these in your
# process manager / docker-compose.

# Access token required from remote clients. If unset, one is generated into
# <data-dir>/token and printed at startup.
# REDISUI_AUTH_TOKEN=change-me

# Key used to encrypt credentials at rest. 64 hex chars, or any passphrase
# (hashed with SHA-256). If unset, a key is generated into <data-dir>/master.key.
# REDISUI_MASTER_KEY=change-me

# Set to 1 to disable credential encryption (not recommended).
# REDISUI_DISABLE_ENCRYPTION=0
